# ---- Runtime mode ----
# MUST be "release" in production. It is what switches the session cookie to
# SameSite=None; Secure, without which the browser drops the cookie on every
# cross-site request from the deployed frontend. Leave unset for local dev.
GIN_MODE=

# ---- Mongo ----
MONGOURI=mongodb://localhost:27017

# ---- Sessions / JWT ----
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered verbatim as an Authorized redirect URI in Google Cloud Console.
CLIENT_CALLBACK_URL=http://localhost:2117/google_callback

# ---- Frontend ----
# Where /google_callback sends the browser once the session cookie is set.
# Must be the frontend's /login-redirect route.
FRONTEND_REDIRECT_URL=http://localhost:5173/login-redirect
# Allowed CORS origins (origin only, no path). Comma-separate for more than one.
# localhost:3000 and localhost:5173 are always allowed.
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Quiz ----
# Exam length in minutes (default 80).
TEST_DURATION=80

# ---- Admin portal ----
# Note the "1"/"2" suffixes - these exact names are what admin_portal reads.
# Account 1 is the full admin (add questions, assign shifts, set timings).
ADMIN_USER1=admin
ADMIN_PASS1=
# Account 2 is read-only (can view registration responses). Optional - leave
# both blank to disable it.
ADMIN_USER2=
ADMIN_PASS2=
